DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Optional: set for instant slash command registration during development
DISCORD_GUILD_ID=
# Optional: path to SQLite database (default: ./queen.db)
QUEEN_DB_PATH=./queen.db
# Optional: max concurrent pawn sessions (default: 50)
QUEEN_MAX_PAWNS=50

# --- AWS Bedrock fallback (used when /config backend bedrock is set) ---
# Toggle the backend at runtime via /config backend; these vars only need to be
# present when Bedrock is the active backend.
AWS_REGION=us-west-2
# Preferred: a Bedrock API key (created in the Bedrock console under "API keys").
# AWS_BEARER_TOKEN_BEDROCK=
# Or fall back to the standard AWS credential chain:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# Bedrock inference profile IDs (use cross-region "global." or "us." prefixes):
# ANTHROPIC_MODEL=global.anthropic.claude-opus-4-7
# ANTHROPIC_SMALL_FAST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
